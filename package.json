    "check:interactive-map": "node tests/check-interactive-map.mjs",
    "check:geocoding": "node tests/check-geocoding.mjs",
    "check:security": "node tests/check-security-hardening.mjs",
    "check:mfa-ai": "node tests/check-mfa-ai-limits.mjs",
    "check:ai-usage": "node tests/check-ai-usage.mjs",
    "check:market-search": "node tests/check-market-search.mjs",
    "check:market-auto-review": "node tests/check-market-auto-review.mjs",
    "check:market-review-queue": "node tests/check-market-review-queue.mjs",
    "check:push": "node tests/check-private-push.mjs",
    "check:inbox": "node tests/check-notification-center.mjs",
    "check:outing": "node tests/check-family-outing.mjs",
