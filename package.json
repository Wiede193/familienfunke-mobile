    "check:event-photo-pages": "node tests/check-event-photo-pages.mjs && node tests/check-event-photo-app.mjs",
    "check:market-partners": "node tests/check-market-partner-pages.mjs && node tests/check-market-partner-app.mjs",
    "check:ops": "node --test tests/check-staging-load.mjs && node tests/check-ops-readiness.mjs"
