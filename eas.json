{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "simulator": {
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "development-ios": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "development-android": {
      "extends": "development",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
